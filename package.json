{
  "name": "family-ledger",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "migrate": "node --env-file=.env --import tsx src/migrate.ts",
    "dev:api": "node --env-file=.env --import tsx --watch src/server.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/server.js",
    "test": "node --test --import tsx \"test/**/*.test.ts\""
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
